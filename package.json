{
  "name": "cabrelngamaleu-portfolio-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack portfolio with React client and Express server",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "install:all": "npm install",
    "start:client": "npm run start --workspace=client",
    "start:server": "npm run dev --workspace=server",
    "start:all": "concurrently \"npm run start:client\" \"npm run start:server\"",
    "build:client": "npm run build --workspace=client",
    "build:server": "npm run build --workspace=server",
    "build:all": "npm run build:client && npm run build:server",
    "test:client": "npm test --workspace=client",
    "test:server": "npm test --workspace=server",
    "test:all": "npm run test:client && npm run test:server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}
